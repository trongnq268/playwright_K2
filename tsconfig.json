{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["lib/page/*"],
      "@data/*": ["lib/data/*"],
      "@fixtures/*": ["lib/fixture/*"]
    }
  },
  "include": ["tests/**/*.ts", "lib/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules"]
}
