{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020"],
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "./tests/**/*.ts",
    "./locators/**/*.ts",
    "./type/**/*.ts",
    "./playwright.config.ts"
  ]
}
